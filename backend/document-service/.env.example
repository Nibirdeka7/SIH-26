APP_NAME=MediKiosk Document Service
APP_VERSION=0.1.0
DEBUG=True

AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

OCR_CONFIDENCE_THRESHOLD=0.80
TESSERACT_CMD=tesseract

# Vision extraction path (reuses GEMINI_API_KEY above)
GEMINI_VISION_MODEL=gemini-2.5-flash
VISION_CONFIDENCE_THRESHOLD=0.70
VISION_CRITICAL_FIELD_THRESHOLD=0.75
VISION_MAX_RETRIES=1